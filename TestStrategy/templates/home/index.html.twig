{% extends 'base.html.twig' %}

{% block title %}TestStrategy | Gérez vos rendez-vous{% endblock %}

{% block body %}
    <main class="container py-5">
        <section class="text-center py-5">
            <p class="text-primary text-uppercase fw-semibold small">Organiser. Partager. Réserver.</p>
            <h1 class="display-3 fw-bold">TestStrategy</h1>
            <p class="lead mx-auto my-4" style="max-width: 720px;">
                Une solution simple pour organiser vos disponibilités et permettre à vos contacts de réserver un
                rendez-vous au moment qui leur convient.
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a class="btn btn-primary btn-lg px-4" href="{{ path('sign_up') }}">Créer un compte</a>
                <a class="btn btn-outline-primary btn-lg px-4" href="{{ path('sign_in') }}">Se connecter</a>
            </div>
        </section>

        <section class="border-top pt-5">
            <div class="row g-4">
                <div class="col-md-4">
                    <h2 class="h4">Votre agenda</h2>
                    <p class="text-secondary">Définissez vos disponibilités et partagez facilement votre lien de réservation.</p>
                </div>
                <div class="col-md-4">
                    <h2 class="h4">Vos rendez-vous</h2>
                    <p class="text-secondary">Centralisez vos demandes et suivez chaque réservation depuis votre espace.</p>
                </div>
                <div class="col-md-4">
                    <h2 class="h4">Un compte personnel</h2>
                    <p class="text-secondary">Conservez vos informations et retrouvez vos rendez-vous au même endroit.</p>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
