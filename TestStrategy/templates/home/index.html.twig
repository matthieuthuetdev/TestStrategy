{% extends 'base.html.twig' %}

{% block title %}TestStrategy{% endblock %}

{% block body %}
    <main>
        <section class="hero">
            <h1>TestStrategy</h1>
            <div class="hero__content">
                <p>
                    Organisez vos rendez-vous simplement et partagez vos disponibilités en quelques instants.
                    TestStrategy vous permet de créer un agenda personnalisé, de le partager avec vos contacts
                    et de gérer vos réservations au même endroit.
                </p>
            </div>
        </section>

        <section class="account-benefits">
            <h2>Les avantages d'un compte</h2>
            <div class="account-benefits__content">
                <article>
                    <h3>Créer son propre agenda</h3>
                    <p>
                        Avec un compte, vous pouvez créer votre agenda, définir vos horaires de disponibilité,
                        choisir la durée de vos rendez-vous et partager facilement votre lien de réservation.
                    </p>
                </article>

                <article>
                    <h3>Suivre ses rendez-vous</h3>
                    <p>
                        Retrouvez l'historique de vos rendez-vous et gardez une vue claire sur vos réservations.
                        Vous pouvez également recevoir des notifications et des rappels par e-mail selon vos préférences.
                    </p>
                </article>
            </div>
        </section>
    </main>
{% endblock %}
