{% extends 'base.html.twig' %}

{% block title %}Créer un compte | TestStrategy{% endblock %}

{% block body %}
    <main class="signup-page d-flex align-items-center py-5">
        <div class="container">
            <div class="signup-card mx-auto p-4 p-md-5">
                <div class="text-center mb-4">
                    <h1 class="h2 mb-2">Créer un compte</h1>
                    <p class="text-secondary mb-0">Rejoignez TestStrategy pour gérer vos rendez-vous.</p>
                </div>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success" role="alert">{{ message }}</div>
                {% endfor %}

                {% if not form.vars.valid %}
                    <div class="alert alert-danger" role="alert">
                        <ul class="mb-0">
                            {% for formError in form.vars.errors %}
                                <li>{{ formError.message }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {{ form_start(form, { action: path('sign_up'), method: 'POST' }) }}
                    {{ form_row(form.firstName) }}
                    {{ form_row(form.lastName) }}
                    {{ form_row(form.email) }}
                    {{ form_row(form.password) }}
                    <ul class="password-requirements small text-secondary">
                        <li>Au moins 8 caractères</li>
                        <li>Au moins une lettre minuscule</li>
                        <li>Au moins une lettre majuscule</li>
                        <li>Au moins un chiffre</li>
                        <li>Au moins un caractère spécial</li>
                    </ul>
                    {{ form_row(form.confirmPassword) }}

                    <button class="btn btn-primary w-100 mt-3" type="submit">Créer mon compte</button>
                {{ form_end(form) }}
            </div>
        </div>
    </main>
{% endblock %}
